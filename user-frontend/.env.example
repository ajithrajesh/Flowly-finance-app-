# Backend API Base URL (including /api)
# In production on Vercel, set this to your AWS EC2/App Runner backend URL:
# Example: https://api.flowlyfinance.com/api or http://<aws-ec2-public-ip>:5000/api
VITE_API_BASE=https://your-backend-api-url.com/api

# Google OAuth Client ID for User Authentication
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
