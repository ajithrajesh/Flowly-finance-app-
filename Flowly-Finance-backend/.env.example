# ==============================================================
# Flowly Finance Backend Environment Configuration
# ==============================================================

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or self-hosted)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flowly?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_strong_jwt_secret_key_minimum_32_characters

# SMTP Email Configuration (Nodemailer / Gmail App Password / Amazon SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM="Flowly Finance" <no-reply@flowlyfinance.com>

# Google OAuth Configuration (for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudinary (Document & KYC Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=flowly-kyc-backend
REQUIRE_VIDEO_KYC=false

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Cron Job Configurations (Optional overrides)
# MONTHLY_STATEMENT_CRON=0 0 1 * *
